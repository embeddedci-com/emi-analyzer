# Local stack secrets and state
deploy/.env
worker/.env

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Node. No trailing slash, so a node_modules symlinked in from another checkout counts too.
node_modules
dist/

# Dev harness boards: generated from real boards, and those boards are not ours to commit
webapp/dev/public/
webapp/public/*.kicad_pcb

# Board files dropped in for a one-off smoke run
worker/tests/fixtures/*.kicad_pcb
!worker/tests/fixtures/tiny.kicad_pcb
!worker/tests/fixtures/sample.kicad_pcb
!worker/tests/fixtures/decoupling_demo.kicad_pcb
# Hand-written, like tiny: a power input, a ferrite and a buck, for the conducted scan.
!worker/tests/fixtures/buck.kicad_pcb
# Hand-written: a 12 V input feeding a two-buck PMIC, a boost and a buck module.
!worker/tests/fixtures/regulators.kicad_pcb
# Hand-written: capacitors carrying MPN and LCSC fields, for matching by part number.
!worker/tests/fixtures/part_numbers.kicad_pcb

# The gerber fixture is generated from tiny.kicad_pcb and IS committed, so the test suite
# runs without KiCad installed. Regenerate with worker/scripts/make_gerber_fixture.py.
!worker/tests/fixtures/gerber/

# Gerber zips built for a browser test
webapp/public/*.zip


# The local app: build outputs
bin/
webapp/dist-app/
server/cmd/emi-local/web/*
!server/cmd/emi-local/web/.gitkeep
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/gen/

# pip's build directory; never source
worker/build/

# Local editor/agent tooling
.claude/

# Copy to .env beside this file. The first two are required; everything else has a default.
# See docs/running-a-worker.md.

# The EMI Analyzer app this worker dials into. From a container on the same machine:
EMBEDDEDCI_URL=http://host.docker.internal:7465

# Issued by the app, once:   emi-local -issue-key
EMBEDDEDCI_API_KEY=

# How this worker is named in the worker list. Inside a container the hostname is a random hex
# string, so it is worth setting.
# EMI_WORKER_NAME=

# EMI_MAX_CONCURRENT=1
# EMI_LOG_LEVEL=DEBUG

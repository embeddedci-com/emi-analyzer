(kicad_pcb
  (version 20241229)
  (generator "emi-analyzer-test-fixture")
  (general (thickness 1.6))
  (layers
    (0 "F.Cu" signal)
    (2 "B.Cu" signal)
    (25 "Edge.Cuts" user)
  )
  (setup
    (stackup
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 1.53) (material "FR4")
             (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035))
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "CLK")
  (net 3 "DATA")

  (gr_rect (start 0 0) (end 50 40) (layer "Edge.Cuts") (width 0.1))

  (footprint "TestPad:0805" (layer "F.Cu") (at 10 10 90)
    (property "Reference" "U1" (at 0 0 0) (layer "F.SilkS"))
    (pad "1" smd roundrect (at -1 0 90) (size 1.2 0.8) (layers "F.Cu" "F.Mask")
         (roundrect_rratio 0.25) (net 2 "CLK"))
    (pad "2" smd rect (at 1 0 90) (size 1.2 0.8) (layers "F.Cu" "F.Mask") (net 1 "GND"))
  )
  (footprint "TestPad:TH" (layer "F.Cu") (at 45 38 0)
    (property "Reference" "J1" (at 0 0 0) (layer "F.SilkS"))
    (pad "1" thru_hole circle (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask")
         (net 3 "DATA"))
  )

  (segment (start 10 10) (end 19 20) (width 0.2) (layer "F.Cu") (net 2))
  (segment (start 19 20) (end 40 20) (width 0.2) (layer "F.Cu") (net 2))
  (segment (start 5 38) (end 45 38) (width 0.2) (layer "F.Cu") (net 3))
  (segment (start 12 2) (end 20 2) (width 0.3) (layer "B.Cu") (net 3))
  (arc (start 40 20) (mid 43 22) (end 45 25) (width 0.25) (layer "F.Cu") (net 2))

  (via (at 25 20) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 6 6) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1))
  (via (at 16 2) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 3))

  (zone (net 1) (net_name "GND") (layer "B.Cu")
    (hatch edge 0.5) (min_thickness 0.25)
    (polygon (pts (xy 5 5) (xy 20 5) (xy 20 35) (xy 5 35)))
    (filled_polygon (layer "B.Cu") (pts (xy 5 5) (xy 20 5) (xy 20 35) (xy 5 35)))
  )
  (zone (net 1) (net_name "GND") (layer "B.Cu")
    (hatch edge 0.5) (min_thickness 0.25)
    (polygon (pts (xy 30 5) (xy 45 5) (xy 45 35) (xy 30 35)))
    (filled_polygon (layer "B.Cu") (pts (xy 30 5) (xy 45 5) (xy 45 35) (xy 30 35)))
  )
)

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMI Analyzer",
  "version": "0.0.0",
  "identifier": "com.embeddedci.emi-analyzer",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "PCB EMI and EMC analysis on your own computer",
    "longDescription": "Upload a KiCad board or Gerber files and run geometric EMI and EMC checks, ESD transient simulation and full-wave openEMS solves locally. The analysis worker runs in Docker.",
    "copyright": "Copyright EmbeddedCI contributors",
    "license": "Apache-2.0",
    "externalBin": [
      "binaries/emi-local"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
